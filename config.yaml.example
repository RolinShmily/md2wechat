# md2wechat 配置文件模板 (config.yaml.example)
#
# 配置查找顺序（首个命中的文件生效）:
#   1) 命令行 -c / --config <path>
#   2) 环境变量 MD2WECHAT_CONFIG
#   3) 当前目录 ./config.yaml
#   4) 用户级 ~/.config/md2wechat/config.yaml
#   5) 系统级 /etc/md2wechat/config.yaml
#
# 凭据只写在 config.yaml（已被 .gitignore 忽略）。WECHAT_APPID / WECHAT_SECRET
# 环境变量仅在对应字段留空时作为兜底；config.yaml 始终优先。

source:
  # 远程博客 Git 仓库地址（支持 HTTPS 或 SSH；留空则仅读取本地文章目录）
  repoUrl: "https://github.com/your-username/your-blog.git"
  # Git 远端名称（默认: origin）
  gitRemote: "origin"
  # Git 目标分支（默认: main）
  gitBranch: "main"
  # 是否自动从远程拉取最新提交（默认: true）
  gitPull: true
  # 自动拉取冷却周期（默认: 24h，冷却期内直接使用本地仓库缓存）
  pullInterval: "24h"
  # 仓库内文章相对路径（默认: content/posts；Hexo 常用 source/_posts）
  postsPath: "content/posts"
  # 博客仓库克隆/缓存位置（可选）。默认: <状态文件目录>/blog-repo
  # 例如系统级安装时默认 /var/lib/md2wechat/blog-repo。
  # repoRoot: "/var/lib/md2wechat/blog-repo"
  # （可选）若直接使用本地已有文章目录，可填入相对/绝对路径：
  # postsRoot: "/path/to/blog/content/posts"
  # 文章目录组织形式：bundle (<slug>/index.md) 或 flat (posts/<slug>.md)
  layout: bundle
  # 静态资源查找根目录（按顺序匹配，{postDir} 代表当前文章目录，{repoRoot} 代表博客仓库根目录）
  assetRoots:
    - "{postDir}"
    - "{repoRoot}/public"
  # 文章列表排序: asc (正序) | desc (倒序)
  sortOrder: "asc"

site:
  # 博客网站访问基础 URL（用于文末版权卡片与相对链接补全）
  url: "https://blog.example.com"
  # 文章 URL 路由规则（{slug} 将被替换为具体文章标识）
  postPath: "/posts/{slug}/"
  # 文章默认署名作者
  author: "YourName"
  # 版权声明协议
  license: "CC BY-NC-SA 4.0"

render:
  # 内置 28 套公众号排版主题 (运行 md2wechat themes 可查看全部清单)
  # 推荐: tech-blue (科技蓝), fullstack-blue (全栈蓝), klein (克莱因蓝)
  theme: "tech-blue"
  # 主色调覆盖（留空则跟随主题默认主色，例如填: "#0e88eb"）
  accent: ""
  # 正文字号 (px)
  fontSize: 15
  # 字体方案: theme (跟随主题), sans (黑体), serif (宋体), rounded (圆体)
  fontFamily: "theme"
  # 是否开启 Mac 风格代码块窗口
  macCode: true
  # 图片画廊排版模式: stack (单列堆叠), grid (网格), collage (拼贴)
  galleryMode: "stack"
  # 是否将非微信域名的外部链接自动转换为文末带编号的【参考资料】脚注
  linksToFootnotes: true
  # 是否将正文 h1~h5 标题顺移为 h2~h6（防止章节标题与主题刊头居中大标题冲突）
  shiftBodyHeadings: true
  # 图片图注模式: smart (智能过滤无意义截图名称), all (保留所有图注), none (不生成图注)
  imageCaptionMode: "smart"
  # 是否在正文顶部额外插入一张封面大图
  insertHeaderCover: false
  # 是否在正文末尾追加原文链接与版权说明卡片
  appendCopyrightCard: true

sync:
  # 同步基线 / 状态文件（相对 config.yaml 所在目录解析）。
  # 默认规则:
  #   - root / systemd / 已存在 /etc/md2wechat 时: /var/lib/md2wechat/state.json
  #   - 普通本地用户: ~/.local/share/md2wechat/state.json
  # 记录每篇文章的 contentHash、草稿 media_id 与图片缓存，也就是"哪些文章已经推过"。
  # ⚠️ 该文件是【机器本地】的：新机器/VPS 上为空时，所有文章都会被当作"新增"。
  #    为防止误推，空基线且存在待推文章时 sync 会中止，需先 `md2wechat baseline`
  #    （或把原机器的 state.json 复制过来）；确属首次推送则加 `--initial-push`。
  # stateFile: "/var/lib/md2wechat/state.json"
  # 单次同步推送的最大文章数量（防止首次或批量同步超出微信 API 调用上限）
  maxPerRun: 5
  # 定时 sync 时是否自动将已修改的老文章也重新推送（默认 false；老文章修改后
  # 建议人工运行 `md2wechat push` 选择推送）
  syncUpdated: false
  # 唯一兜底封面：仅当文章 frontmatter 没有 image 时使用（支持 {repoRoot} 占位符）。
  # 留空则这些文章会因缺少封面而同步失败，不会再去猜正文首图。
  defaultCover: "{repoRoot}/public/og/og.png"
  # 是否自动下载 jsDelivr 等外链图片转传至微信（防防盗链过滤）
  downloadRemoteImages: true
  # 是否开启草稿评论功能 (0 关闭, 1 开启)
  openComment: 0
  # 是否仅粉丝可评论 (0 所有人, 1 仅粉丝)
  onlyFansCanComment: 0

wechat:
  # 凭据以本文件为准；WECHAT_APPID / WECHAT_SECRET 环境变量仅在留空时作为兜底
  # （留空则微信同步会因缺少凭据而中止，不会用占位值凑数）
  appId: ""
  appSecret: ""

notify:
  # 可选：同步结果 Webhook 通知地址（支持飞书 / 企业微信 / 钉钉 / 通用 JSON）
  # 本文件优先；留空时回退到 MD2WECHAT_WEBHOOK_URL 环境变量
  webhookUrl: ""
  onSuccess: true
  onFailure: true
